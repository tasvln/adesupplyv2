---
import Layout from '../layouts/Layout.astro';
import Project from '../components/project.astro';
import { getCollection } from 'astro:content';

import type { ProjectItem } from '../types';

const notes = [
  {
    entry: 'Entry // 2026.07',
    title: 'Ocean rendering on the GPU with FFT',
    body: 'Notes on the butterfly FFT, groupshared memory tricks, and turning a height field into normals.',
  },
  {
    entry: 'Entry // 2026.06',
    title: 'What SM_120 changes for CUDA ray tracing',
    body: 'Working notes from porting a ray tracer to Blackwell.',
  },
];

const entries = await getCollection('projects');

const projects: ProjectItem[] = entries.map((project) => ({
  id: project.id,
  title: project.data.title,
  category: project.data.category,
  status: project.data.status,
  swatch: project.data.swatch ?? 'PR',
  code: project.data.code ?? project.id.toUpperCase(),
  media: project.data.images,
  detail: project.data.description,
  tags: project.data.tags,
  links: [
    ...(project.data.links?.github ? [{ label: 'GitHub', href: project.data.links.github }] : []),
    ...(project.data.links?.demo ? [{ label: 'Live', href: project.data.links.demo }] : []),
  ],
}));
---

<Layout title="Ade — Software Engineer">
  <div class="min-h-screen flex justify-center items-start py-12 px-4">
    <div class="w-full max-w-5xl bg-card border border-line">
      <div
        class="px-6 pt-6 pb-4 flex justify-between border-b border-line gap-8 flex-col md:flex-row md:gap-0"
      >
        <div class="flex flex-col gap-12">
          <div class="flex flex-col">
            <h1 class="font-stencil text-2xl font-bold">Temitope Adebayo</h1>
            <p class="text-xs text-ink-dim mt-1 tracking-[0.04em] uppercase">
              Graphics / GPU / Embedded Programming
            </p>
          </div>
          <p class="mt-4 text-[12.5px] leading-relaxed max-w-[54ch]">
            Renderers, emulators, and low-level systems built in C++, Rust, Metal and CUDA. Based in
            Toronto, Ontario.
          </p>
        </div>
        <div class="flex flex-col gap-2">
          <button
            class="w-auto tab-btn text-center border py-1 px-4 text-xs tracking-[0.12em] font-semibold uppercase text-ink-dim border-line data-[active]:bg-green-200"
            data-tab="projects"
            data-active
            type="button">Projects</button
          >
          <button
            class="w-auto tab-btn text-center border py-1 px-4 text-xs tracking-[0.12em] font-semibold uppercase text-ink-dim border-line disabled:opacity-10 data-[active]:bg-green-200"
            data-tab="research"
            disabled
            title="soon"
            type="button">research::papers</button
          >
          <button
            class="w-auto tab-btn text-center border py-1 px-4 text-xs tracking-[0.12em] font-semibold uppercase text-ink-dim border-line disabled:opacity-10 data-[active]:bg-green-200"
            data-tab="research"
            disabled
            title="soon"
            type="button">schema::blueprints</button
          >
          <a
            class="w-auto text-center border py-1 px-4 text-xs tracking-[0.12em] font-semibold uppercase text-ink-dim border-line"
            href="https://instagram.com/byoladimeji"
            target="_blank"
          >
            Design::Archive
          </a>
          <button
            class="w-auto tab-btn text-center border py-1 px-4 text-xs tracking-[0.12em] font-semibold uppercase text-ink-dim border-line data-[active]:bg-green-200"
            data-tab="contact"
            type="button">Contact</button
          >
        </div>
      </div>

      <Project projects={projects} />

      <div class="tab-panel hidden" data-panel="research">
        {
          notes.map((n) => (
            <div class="px-6 py-4 border-b border-line last:border-b-0">
              <div class="text-[10.5px] tracking-[0.1em] text-ink-dim uppercase mb-1.5">
                {n.entry}
              </div>
              <h3 class="text-[13px] uppercase tracking-[0.02em] font-bold mb-1">{n.title}</h3>
              <p class="text-xs text-ink-dim leading-relaxed">
                {n.body} (replace with your real post)
              </p>
            </div>
          ))
        }
      </div>

      <div class="tab-panel hidden" data-panel="contact">
        <a
          class="flex justify-between items-center px-6 py-4 border-b border-line text-[12.5px] uppercase tracking-[0.04em]"
          href="mailto:tsad3bayo@outlook.com">Email <span>→</span></a
        >
        <a
          class="flex justify-between items-center px-6 py-4 border-b border-line text-[12.5px] uppercase tracking-[0.04em]"
          href="https://github.com/tasvln">GitHub <span>→</span></a
        >
        <a
          class="flex justify-between items-center px-6 py-4 text-[12.5px] uppercase tracking-[0.04em]"
          href="https://linkedin.com/in/tasvln">LinkedIn <span>→</span></a
        >
      </div>
    </div>
  </div>

  <div
    id="mobile-modal"
    class="hidden md:hidden fixed inset-0 z-50 items-center justify-center bg-black/60 p-4"
  >
    <div class="bg-card border border-line w-full max-w-md max-h-[85vh] overflow-y-auto relative">
      <button
        id="mobile-modal-close"
        type="button"
        aria-label="Close"
        class="absolute top-3 right-3 w-7 h-7 border border-line flex items-center justify-center text-sm text-ink-dim bg-card-2"
        >×</button
      >
      <div id="mobile-modal-content" class="p-6 pt-14 bg-white"></div>
    </div>
  </div>

  <script>
    // Top-level tab switching (Projects / Research / Contact)
    const tabs = document.querySelectorAll<HTMLElement>('.tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

    function activateTab(name: string) {
      tabs.forEach((t) => {
        const isActive = t.dataset.tab === name;
        t.toggleAttribute('data-active', isActive);
      });
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.dataset.panel !== name);
      });
    }

    tabs.forEach((tab) => {
      if ((tab as HTMLButtonElement).disabled) return;
      tab.addEventListener('click', () => activateTab(tab.dataset.tab!));
    });

    // Project list -> detail pane (desktop) / modal (mobile)
    const projectItems = document.querySelectorAll<HTMLElement>('.proj-list-item');
    const detailPanes = document.querySelectorAll<HTMLElement>('.proj-detail-pane');
    const mq = window.matchMedia('(min-width: 768px)');

    const mobileModal = document.getElementById('mobile-modal');
    const mobileModalContent = document.getElementById('mobile-modal-content');
    const mobileModalClose = document.getElementById('mobile-modal-close');

    // If any of these are missing, log it instead of throwing and killing
    // every listener below (this was the likely cause of "nothing happens").
    if (!mobileModal || !mobileModalContent || !mobileModalClose) {
      console.error('[project-modal] missing element(s):', {
        mobileModal: !!mobileModal,
        mobileModalContent: !!mobileModalContent,
        mobileModalClose: !!mobileModalClose,
      });
    }

    function openMobileModal(pane: HTMLElement) {
      if (!mobileModal || !mobileModalContent) return;
      mobileModalContent.innerHTML = pane.innerHTML;
      mobileModalContent.scrollTop = 0;
      mobileModal.classList.remove('hidden');
      mobileModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileModal() {
      if (!mobileModal) return;
      mobileModal.classList.add('hidden');
      mobileModal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    mobileModalClose?.addEventListener('click', closeMobileModal);
    mobileModal?.addEventListener('click', (e) => {
      if (e.target === mobileModal) closeMobileModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileModal?.classList.contains('hidden')) closeMobileModal();
    });

    console.log(
      '[project-modal] items found:',
      projectItems.length,
      'panes found:',
      detailPanes.length,
    );

    projectItems.forEach((item) => {
      item.addEventListener('click', () => {
        const id = item.dataset.project!;
        projectItems.forEach((i) => i.toggleAttribute('data-active', i.dataset.project === id));

        if (mq.matches) {
          detailPanes.forEach((p) => {
            p.style.display = p.dataset.projectDetail === id ? '' : 'none';
          });
        } else {
          const pane = document.querySelector<HTMLElement>(
            `.proj-detail-pane[data-project-detail="${id}"]`,
          );
          console.log('[project-modal] click:', { id, mqMatches: mq.matches, paneFound: !!pane });
          if (pane) {
            openMobileModal(pane);
            console.log(
              '[project-modal] after open, modal classList:',
              mobileModal?.className,
              'computed display:',
              mobileModal ? getComputedStyle(mobileModal).display : 'n/a',
              'z-index:',
              mobileModal ? getComputedStyle(mobileModal).zIndex : 'n/a',
            );
          }
        }
      });
    });

    mq.addEventListener('change', (e) => {
      if (e.matches) {
        closeMobileModal();
        const activeItem = document.querySelector<HTMLElement>('.proj-list-item[data-active]');
        const id = activeItem?.dataset.project;
        detailPanes.forEach((p) => {
          p.style.display = p.dataset.projectDetail === id ? '' : 'none';
        });
      }
    });

    document.getElementById('cta-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      activateTab('contact');
    });
  </script>
</Layout>
