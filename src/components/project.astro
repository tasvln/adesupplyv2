---
import type { ProjectItem } from '../types';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props as Props;

function isVideoSrc(src: unknown): boolean {
  if (typeof src !== 'string') return false;
  return /\.(mp4|webm|mov|m4v)$/i.test(src);
}
---
<div class="tab-panel flex flex-col md:flex-row" data-panel="projects">
    <!-- LEFT: project list -->
    <div class="w-full flex-shrink-0 md:w-[300px] md:border-r border-line">
        {
        projects.map((p, i) => (
            <button
            type="button"
            class="proj-list-item w-full flex items-center gap-3 px-4 py-3 border-b border-line last:border-b-0 text-left data-[active]:bg-card-2"
            data-project={p.id}
            data-active={i === 0 ? true : undefined}
            >
            <div class="w-9 h-9 flex-shrink-0 bg-card-2 border border-line flex items-center justify-center text-[10px] font-bold text-ink-dim">
                {p.swatch}
            </div>
            <div class="min-w-0">
                <div class="text-[10px] tracking-[0.08em] text-ink-dim uppercase">{p.code}</div>
                <div class="text-[12.5px] font-bold uppercase tracking-[0.01em] truncate">
                {p.title}
                </div>
            </div>
            <!-- mobile-only affordance so it reads as "tap to open" -->
            <span class="ml-auto md:hidden text-ink-dim text-sm">→</span>
            </button>
        ))
        }
    </div>
    <!-- RIGHT: detail pane (desktop only — mobile uses the modal below) -->
    <div class="hidden md:block flex-1 min-w-0 p-6">
        {projects.map((p, i) => (
            <div
            class="proj-detail-pane"
            data-project-detail={p.id}
            style={i === 0 ? '' : 'display:none'}
            >
            <div class="text-[11px] tracking-[0.1em] text-ink-dim uppercase mb-2">
                {p.category}
            </div>
            <h2 class="text-xl font-bold uppercase tracking-[0.01em] mb-3">{p.title}</h2>

            {p.media && p.media.length > 0 ? (
                p.media.map((m: string) => (
                    isVideoSrc(m) ? (
                        <video
                            src={m}
                            controls
                            muted
                            loop
                            playsinline
                            class="w-full aspect-video object-cover border border-line bg-black border-b-0 last:border-b-2"
                        />
                    ) : (
                        <img
                            src={m}
                            alt={p.title}
                            class="w-full aspect-video object-cover border border-line border-b-0 last:border-b-2"
                        />
                    )
                ))
            ) : (
                <div class="w-full aspect-video border border-dashed border-line bg-card-2 flex items-center justify-center border-b-0 last:border-b-2">
                    <span class="text-[11px] tracking-[0.1em] text-ink-dim uppercase">
                        + Image / Video
                    </span>
                </div>
            )}

            <p class="text-[13px] text-ink-dim leading-relaxed max-w-full my-5">{p.detail}</p>
            <div class="border-t border-line pt-3 flex gap-6">
                <div class="w-20 flex-shrink-0 text-xs font-bold uppercase">Status</div>
                <div class="text-xs text-ink-dim">{p.status}</div>
            </div>
            <div class="border-t border-line pt-3 mt-3 flex gap-6">
                <div class="w-20 flex-shrink-0 text-xs font-bold uppercase">Stack</div>
                <div class="flex gap-2 flex-wrap">
                {p.tags.map((tag) => (
                    <span class="text-[11px] px-2.5 py-1 border border-line bg-card-2 uppercase tracking-[0.02em]">
                    {tag}
                    </span>
                ))}
                </div>
            </div>
            {p.links?.length > 0 && (
                <div class="border-t border-line pt-3 mt-3 flex gap-6">
                <div class="w-20 flex-shrink-0 text-xs font-bold uppercase">Links</div>
                <div class="flex gap-4 flex-wrap">
                    {p.links.map((link) => (
                    <a href={link?.href} class="text-xs text-ink underline underline-offset-2">
                        {link?.label}
                    </a>
                    ))}
                </div>
                </div>
            )}
            </div>
        ))}
    </div>
</div>